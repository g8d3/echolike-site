{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://echolike.app/directory/api/schema/crypto_jobs.json",
 "title": "Crypto jobs",
 "type": "object",
 "properties": {
  "fields": {
   "type": "object",
   "properties": {
    "name": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Name",
         "x-kind": "text",
         "x-source": "seed",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "url": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Site",
         "x-kind": "url",
         "x-source": "seed",
         "type": "string",
         "format": "uri"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "company": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Company",
         "x-kind": "ref",
         "x-source": "ai",
         "x-ref-type": "protocols",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "role": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Role",
         "x-kind": "enum",
         "x-source": "ai",
         "enum": [
          "engineering",
          "design",
          "marketing",
          "bd",
          "research",
          "ops",
          "other"
         ]
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "remote": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Remote",
         "x-kind": "bool",
         "x-source": "ai",
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "pay": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Pay",
         "x-kind": "money",
         "x-source": "ai",
         "x-unit": "USD",
         "type": "object",
         "properties": {
          "usd": {
           "type": "number",
           "minimum": 0
          },
          "period": {
           "enum": [
            "one_time",
            "month",
            "year",
            "per_call",
            "per_1M_tokens",
            "per_GB",
            "per_hour",
            "per_seat_month"
           ]
          }
         },
         "required": [
          "usd",
          "period"
         ],
         "description": "period year for salaries"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "posted": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Posted",
         "x-kind": "date",
         "x-source": "ai",
         "type": "string",
         "format": "date"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "notes": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Notes",
         "x-kind": "text",
         "x-source": "manual",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    }
   }
  }
 }
}