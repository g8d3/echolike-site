{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://echolike.app/directory/api/schema/model_providers.json",
 "title": "AI model providers & inference APIs",
 "type": "object",
 "properties": {
  "fields": {
   "type": "object",
   "properties": {
    "name": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Name",
         "x-kind": "text",
         "x-source": "seed",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "url": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Site",
         "x-kind": "url",
         "x-source": "seed",
         "type": "string",
         "format": "uri"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "provider_id": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Canonical id",
         "x-kind": "enum",
         "x-source": "ai",
         "enum": [
          "openai",
          "anthropic",
          "google",
          "xai",
          "openrouter",
          "ollama",
          "opencode",
          "groq",
          "together",
          "deepseek",
          "mistral",
          "local_llama_cpp",
          "lm_studio",
          "vllm",
          "azure_openai",
          "bedrock",
          "vertex",
          "nous_portal",
          "zhipu",
          "moonshot",
          "qwen",
          "minimax",
          "github_copilot",
          "fireworks",
          "cerebras",
          "perplexity",
          "huggingface",
          "venice"
         ],
         "description": "shared id used by harnesses.native_providers"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "model_count": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Models",
         "x-kind": "count",
         "x-source": "ai",
         "type": "integer",
         "minimum": 0
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "price_in": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "$ / 1M input (reference mid model)",
         "x-kind": "usd_per_1m_tokens",
         "x-source": "ai",
         "x-unit": "USD per 1M tokens",
         "type": "number",
         "minimum": 0
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "price_out": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "$ / 1M output (reference mid model)",
         "x-kind": "usd_per_1m_tokens",
         "x-source": "ai",
         "x-unit": "USD per 1M tokens",
         "type": "number",
         "minimum": 0
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "openai_compatible": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "OpenAI-compatible API",
         "x-kind": "bool",
         "x-source": "ai",
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "anthropic_compatible": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Anthropic-compatible API",
         "x-kind": "bool",
         "x-source": "ai",
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "crypto_pay": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Pays in crypto",
         "x-kind": "bool",
         "x-source": "ai",
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "free_tier": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Free tier",
         "x-kind": "bool",
         "x-source": "ai",
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "pricing_model": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Pricing model",
         "x-kind": "enum",
         "x-source": "ai",
         "enum": [
          "free_oss",
          "subscription",
          "usage_based",
          "lifetime",
          "percent_of_volume",
          "network_cost_plus_flat"
         ]
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "notes": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Notes",
         "x-kind": "text",
         "x-source": "manual",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    }
   }
  }
 }
}