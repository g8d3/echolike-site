{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://echolike.app/directory/api/schema/dexes.json",
 "title": "DEXes & perp DEXes",
 "type": "object",
 "properties": {
  "fields": {
   "type": "object",
   "properties": {
    "name": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Name",
         "x-kind": "text",
         "x-source": "seed",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "url": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Site",
         "x-kind": "url",
         "x-source": "seed",
         "type": "string",
         "format": "uri"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "kind": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Spot / perp",
         "x-kind": "enum",
         "x-source": "ai",
         "enum": [
          "spot",
          "perp",
          "both"
         ]
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "chains": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Chains",
         "x-kind": "enum_list",
         "x-source": "ai",
         "type": "array",
         "items": {
          "enum": [
           "ethereum",
           "solana",
           "base",
           "arbitrum",
           "optimism",
           "bsc",
           "polygon",
           "hyperliquid",
           "sui",
           "aptos",
           "ton",
           "tron",
           "bitcoin",
           "avalanche",
           "starknet",
           "zksync",
           "linea",
           "blast",
           "monad",
           "berachain"
          ]
         }
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "maker_fee_bps": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Maker fee (bps)",
         "x-kind": "bps",
         "x-source": "ai",
         "x-unit": "basis_points",
         "type": "number",
         "minimum": 0
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "taker_fee_bps": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Taker fee (bps)",
         "x-kind": "bps",
         "x-source": "ai",
         "x-unit": "basis_points",
         "type": "number",
         "minimum": 0
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "builder_code_max_fee_bps": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Builder code max fee (bps)",
         "x-kind": "bps",
         "x-source": "ai",
         "x-unit": "basis_points",
         "type": "number",
         "minimum": 0
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "referral_rebate_pct": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Referral rebate % of fees",
         "x-kind": "percent",
         "x-source": "ai",
         "x-unit": "percent",
         "type": "number",
         "minimum": 0,
         "maximum": 100
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "kyc": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "KYC required",
         "x-kind": "bool",
         "x-source": "ai",
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "api": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Public API",
         "x-kind": "bool",
         "x-source": "ai",
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "volume_30d_usd": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "30d volume (USD)",
         "x-kind": "usd",
         "x-source": "defillama",
         "x-unit": "USD",
         "type": "number",
         "minimum": 0
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "notes": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Notes",
         "x-kind": "text",
         "x-source": "manual",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    }
   }
  }
 }
}