{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://echolike.app/directory/api/schema/launchpads.json",
 "title": "Token launchpads",
 "type": "object",
 "properties": {
  "fields": {
   "type": "object",
   "properties": {
    "name": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Name",
         "x-kind": "text",
         "x-source": "seed",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "url": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Site",
         "x-kind": "url",
         "x-source": "seed",
         "type": "string",
         "format": "uri"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "chains": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Chains",
         "x-kind": "enum_list",
         "x-source": "ai",
         "type": "array",
         "items": {
          "enum": [
           "ethereum",
           "solana",
           "base",
           "arbitrum",
           "optimism",
           "bsc",
           "polygon",
           "hyperliquid",
           "sui",
           "aptos",
           "ton",
           "tron",
           "bitcoin",
           "avalanche",
           "starknet",
           "zksync",
           "linea",
           "blast",
           "monad",
           "berachain"
          ]
         }
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "launch_fee": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Launch fee",
         "x-kind": "money",
         "x-source": "ai",
         "x-unit": "USD",
         "type": "object",
         "properties": {
          "usd": {
           "type": "number",
           "minimum": 0
          },
          "period": {
           "enum": [
            "one_time",
            "month",
            "year",
            "per_call",
            "per_1M_tokens",
            "per_GB",
            "per_hour",
            "per_seat_month"
           ]
          }
         },
         "required": [
          "usd",
          "period"
         ]
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "trade_fee_bps": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Trade fee (bps)",
         "x-kind": "bps",
         "x-source": "ai",
         "x-unit": "basis_points",
         "type": "number",
         "minimum": 0
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "creator_fee_bps": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Creator fee (bps)",
         "x-kind": "bps",
         "x-source": "ai",
         "x-unit": "basis_points",
         "type": "number",
         "minimum": 0
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "graduation_mcap_usd": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Graduation market cap (USD)",
         "x-kind": "usd",
         "x-source": "ai",
         "x-unit": "USD",
         "type": "number",
         "minimum": 0
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "kyc": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "KYC required",
         "x-kind": "bool",
         "x-source": "ai",
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "api": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Public API",
         "x-kind": "bool",
         "x-source": "ai",
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "notes": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Notes",
         "x-kind": "text",
         "x-source": "manual",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    }
   }
  }
 }
}