{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://echolike.app/directory/api/schema/mcp_tools.json",
 "title": "MCP servers & agent tools",
 "type": "object",
 "properties": {
  "fields": {
   "type": "object",
   "properties": {
    "name": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Name",
         "x-kind": "text",
         "x-source": "seed",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "url": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Site",
         "x-kind": "url",
         "x-source": "seed",
         "type": "string",
         "format": "uri"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "repo": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Repo",
         "x-kind": "id",
         "x-source": "seed",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "stars": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Stars",
         "x-kind": "count",
         "x-source": "github",
         "type": "integer",
         "minimum": 0
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "license": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "License (SPDX)",
         "x-kind": "id",
         "x-source": "github",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "last_commit": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Last commit",
         "x-kind": "date",
         "x-source": "github",
         "type": "string",
         "format": "date"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "category": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Category",
         "x-kind": "enum",
         "x-source": "ai",
         "enum": [
          "data",
          "dev",
          "browser",
          "finance",
          "crypto",
          "search",
          "productivity",
          "media",
          "other"
         ]
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "transport": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Transport",
         "x-kind": "enum_list",
         "x-source": "ai",
         "type": "array",
         "items": {
          "enum": [
           "stdio",
           "sse",
           "streamable_http"
          ]
         }
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "auth": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Auth",
         "x-kind": "enum",
         "x-source": "ai",
         "enum": [
          "none",
          "api_key",
          "oauth"
         ]
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "pricing_model": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Pricing model",
         "x-kind": "enum",
         "x-source": "ai",
         "enum": [
          "free_oss",
          "subscription",
          "usage_based",
          "lifetime",
          "percent_of_volume",
          "network_cost_plus_flat"
         ]
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "software_cost": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Software cost",
         "x-kind": "money",
         "x-source": "ai",
         "x-unit": "USD",
         "type": "object",
         "properties": {
          "usd": {
           "type": "number",
           "minimum": 0
          },
          "period": {
           "enum": [
            "one_time",
            "month",
            "year",
            "per_call",
            "per_1M_tokens",
            "per_GB",
            "per_hour",
            "per_seat_month"
           ]
          }
         },
         "required": [
          "usd",
          "period"
         ],
         "description": "license/software price; 0 one_time for free OSS"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "free_tier": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Free tier",
         "x-kind": "bool",
         "x-source": "ai",
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "summary": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Summary",
         "x-kind": "text",
         "x-source": "ai",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "notes": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Notes",
         "x-kind": "text",
         "x-source": "manual",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    }
   }
  }
 }
}