{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://echolike.app/directory/api/schema/strategies.json",
 "title": "Published trading strategies (re-tested)",
 "type": "object",
 "properties": {
  "fields": {
   "type": "object",
   "properties": {
    "name": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Name",
         "x-kind": "text",
         "x-source": "seed",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "url": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Site",
         "x-kind": "url",
         "x-source": "seed",
         "type": "string",
         "format": "uri"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "source_post": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Source post",
         "x-kind": "url",
         "x-source": "ai",
         "type": "string",
         "format": "uri"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "market": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Market",
         "x-kind": "id",
         "x-source": "ai",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "timeframe_minutes": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Timeframe (min)",
         "x-kind": "number",
         "x-source": "ai",
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "test_sharpe": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Test Sharpe",
         "x-kind": "number",
         "x-source": "lab",
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "test_trades": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Test trades",
         "x-kind": "count",
         "x-source": "lab",
         "type": "integer",
         "minimum": 0
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "verdict": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Verdict",
         "x-kind": "enum",
         "x-source": "lab",
         "enum": [
          "pass",
          "fail",
          "pending"
         ]
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "notes": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Notes",
         "x-kind": "text",
         "x-source": "manual",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    }
   }
  }
 }
}