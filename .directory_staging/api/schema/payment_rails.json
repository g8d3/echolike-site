{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://echolike.app/directory/api/schema/payment_rails.json",
 "title": "Agent payment rails",
 "type": "object",
 "properties": {
  "fields": {
   "type": "object",
   "properties": {
    "name": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Name",
         "x-kind": "text",
         "x-source": "seed",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "url": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Site",
         "x-kind": "url",
         "x-source": "seed",
         "type": "string",
         "format": "uri"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "protocol": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Protocol",
         "x-kind": "enum",
         "x-source": "ai",
         "enum": [
          "x402",
          "lightning",
          "stripe",
          "l402",
          "erc20_transfer",
          "other"
         ]
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "chains": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Chains",
         "x-kind": "enum_list",
         "x-source": "ai",
         "type": "array",
         "items": {
          "enum": [
           "ethereum",
           "solana",
           "base",
           "arbitrum",
           "optimism",
           "bsc",
           "polygon",
           "hyperliquid",
           "sui",
           "aptos",
           "ton",
           "tron",
           "bitcoin",
           "avalanche",
           "starknet",
           "zksync",
           "linea",
           "blast",
           "monad",
           "berachain"
          ]
         }
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "fee_pct": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Fee %",
         "x-kind": "percent",
         "x-source": "ai",
         "x-unit": "percent",
         "type": "number",
         "minimum": 0,
         "maximum": 100
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "flat_fee_usd": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Flat fee (USD)",
         "x-kind": "usd",
         "x-source": "ai",
         "x-unit": "USD",
         "type": "number",
         "minimum": 0
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "min_payment_usd": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Min payment (USD)",
         "x-kind": "usd",
         "x-source": "ai",
         "x-unit": "USD",
         "type": "number",
         "minimum": 0
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "sdk_languages": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "SDKs",
         "x-kind": "enum_list",
         "x-source": "ai",
         "type": "array",
         "items": {
          "enum": [
           "typescript",
           "python",
           "go",
           "rust",
           "java"
          ]
         }
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "kyc": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "KYC required",
         "x-kind": "bool",
         "x-source": "ai",
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "notes": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Notes",
         "x-kind": "text",
         "x-source": "manual",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    }
   }
  }
 }
}