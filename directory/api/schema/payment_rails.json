{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://echolike.app/directory/api/schema/payment_rails.json",
 "title": "Agent payment rails",
 "type": "object",
 "properties": {
  "fields": {
   "type": "object",
   "properties": {
    "name": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Name",
         "x-kind": "text",
         "x-source": "seed",
         "type": "string",
         "description": "The project's name."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "url": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Website",
         "x-kind": "url",
         "x-source": "seed",
         "type": "string",
         "format": "uri",
         "description": "The project's official website."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "protocol": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Protocol",
         "x-kind": "enum",
         "x-source": "ai",
         "enum": [
          "x402",
          "lightning",
          "stripe",
          "l402",
          "erc20_transfer",
          "other"
         ],
         "description": "The payment protocol it uses, such as x402 or Lightning."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "chains": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Blockchains",
         "x-kind": "enum_list",
         "x-source": "ai",
         "type": "array",
         "items": {
          "enum": [
           "ethereum",
           "solana",
           "base",
           "arbitrum",
           "optimism",
           "bsc",
           "polygon",
           "hyperliquid",
           "sui",
           "aptos",
           "ton",
           "tron",
           "bitcoin",
           "avalanche",
           "starknet",
           "zksync",
           "linea",
           "blast",
           "monad",
           "berachain"
          ]
         },
         "description": "The blockchains it supports."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "fee_pct": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Fee (%)",
         "x-kind": "percent",
         "x-source": "ai",
         "x-unit": "percent",
         "type": "number",
         "minimum": 0,
         "maximum": 100,
         "description": "Percentage fee charged on each payment."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "flat_fee_usd": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Flat fee per payment ($)",
         "x-kind": "usd",
         "x-source": "ai",
         "x-unit": "USD",
         "type": "number",
         "minimum": 0,
         "description": "A fixed fee in US dollars added to each payment."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "min_payment_usd": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Minimum payment ($)",
         "x-kind": "usd",
         "x-source": "ai",
         "x-unit": "USD",
         "type": "number",
         "minimum": 0,
         "description": "The smallest payment it supports, in US dollars."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "sdk_languages": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "SDK languages",
         "x-kind": "enum_list",
         "x-source": "ai",
         "type": "array",
         "items": {
          "enum": [
           "typescript",
           "python",
           "go",
           "rust",
           "java"
          ]
         },
         "description": "Programming languages with an official SDK."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "kyc": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Identity check required (KYC)",
         "x-kind": "bool",
         "x-source": "ai",
         "type": "boolean",
         "description": "Yes when you must verify your identity before you can use it."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "notes": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Notes",
         "x-kind": "text",
         "x-source": "manual",
         "type": "string",
         "description": "Our editorial notes about this entry."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    }
   }
  }
 }
}