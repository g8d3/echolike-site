{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://echolike.app/directory/api/schema/strategies.json",
 "title": "Published trading strategies (re-tested)",
 "type": "object",
 "properties": {
  "fields": {
   "type": "object",
   "properties": {
    "name": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Name",
         "x-kind": "text",
         "x-source": "seed",
         "type": "string",
         "description": "The project's name."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "url": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Website",
         "x-kind": "url",
         "x-source": "seed",
         "type": "string",
         "format": "uri",
         "description": "The project's official website."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "source_post": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Source post",
         "x-kind": "url",
         "x-source": "ai",
         "type": "string",
         "format": "uri",
         "description": "Link to the public post where the strategy was shared."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "market": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Market",
         "x-kind": "id",
         "x-source": "ai",
         "type": "string",
         "description": "The market the strategy trades, such as BTC-USD."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "timeframe_minutes": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Timeframe (minutes)",
         "x-kind": "number",
         "x-source": "ai",
         "type": "number",
         "description": "Candle length the strategy uses, in minutes."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "test_sharpe": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Sharpe ratio in our test",
         "x-kind": "number",
         "x-source": "lab",
         "type": "number",
         "description": "Risk-adjusted return in our out-of-sample re-test; higher is better."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "test_trades": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Trades in our test",
         "x-kind": "count",
         "x-source": "lab",
         "type": "integer",
         "minimum": 0,
         "description": "Number of trades in our out-of-sample re-test."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "verdict": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Verdict",
         "x-kind": "enum",
         "x-source": "lab",
         "enum": [
          "pass",
          "fail",
          "pending"
         ],
         "description": "Whether the strategy passed our re-test."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "notes": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Notes",
         "x-kind": "text",
         "x-source": "manual",
         "type": "string",
         "description": "Our editorial notes about this entry."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    }
   }
  }
 }
}