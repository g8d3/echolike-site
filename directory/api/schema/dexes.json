{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://echolike.app/directory/api/schema/dexes.json",
 "title": "DEXes & perp DEXes",
 "type": "object",
 "properties": {
  "fields": {
   "type": "object",
   "properties": {
    "name": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Name",
         "x-kind": "text",
         "x-source": "seed",
         "type": "string",
         "description": "The project's name."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "url": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Website",
         "x-kind": "url",
         "x-source": "seed",
         "type": "string",
         "format": "uri",
         "description": "The project's official website."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "kind": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Spot or perpetuals",
         "x-kind": "enum",
         "x-source": "ai",
         "enum": [
          "spot",
          "perp",
          "both"
         ],
         "description": "Whether it trades spot tokens, perpetual futures, or both."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "chains": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Blockchains",
         "x-kind": "enum_list",
         "x-source": "ai",
         "type": "array",
         "items": {
          "enum": [
           "ethereum",
           "solana",
           "base",
           "arbitrum",
           "optimism",
           "bsc",
           "polygon",
           "hyperliquid",
           "sui",
           "aptos",
           "ton",
           "tron",
           "bitcoin",
           "avalanche",
           "starknet",
           "zksync",
           "linea",
           "blast",
           "monad",
           "berachain"
          ]
         },
         "description": "The blockchains it supports."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "maker_fee_bps": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Maker fee (bps)",
         "x-kind": "bps",
         "x-source": "ai",
         "x-unit": "basis_points",
         "type": "number",
         "minimum": 0,
         "description": "Fee for orders that add liquidity, in basis points; 1 bps is 0.01%."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "taker_fee_bps": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Taker fee (bps)",
         "x-kind": "bps",
         "x-source": "ai",
         "x-unit": "basis_points",
         "type": "number",
         "minimum": 0,
         "description": "Fee for orders that take liquidity, in basis points; 1 bps is 0.01%."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "builder_code_max_fee_bps": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Builder code max fee (bps)",
         "x-kind": "bps",
         "x-source": "ai",
         "x-unit": "basis_points",
         "type": "number",
         "minimum": 0,
         "description": "Highest fee an app may add through a builder code, in basis points."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "referral_rebate_pct": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Referral rebate (% of fees)",
         "x-kind": "percent",
         "x-source": "ai",
         "x-unit": "percent",
         "type": "number",
         "minimum": 0,
         "maximum": 100,
         "description": "Share of a referred trader's fees paid back to the referrer, in percent."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "kyc": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Identity check required (KYC)",
         "x-kind": "bool",
         "x-source": "ai",
         "type": "boolean",
         "description": "Yes when you must verify your identity before you can use it."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "api": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Public API",
         "x-kind": "bool",
         "x-source": "ai",
         "type": "boolean",
         "description": "Yes when it offers a documented public API."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "volume_30d_usd": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "30-day volume ($)",
         "x-kind": "usd",
         "x-source": "defillama",
         "x-unit": "USD",
         "type": "number",
         "minimum": 0,
         "description": "Trading volume over the last 30 days, in US dollars."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "notes": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Notes",
         "x-kind": "text",
         "x-source": "manual",
         "type": "string",
         "description": "Our editorial notes about this entry."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    }
   }
  }
 }
}