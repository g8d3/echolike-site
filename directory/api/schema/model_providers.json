{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://echolike.app/directory/api/schema/model_providers.json",
 "title": "AI models on the OpenCode Go plan",
 "type": "object",
 "properties": {
  "fields": {
   "type": "object",
   "properties": {
    "name": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Model",
         "x-kind": "text",
         "x-source": "seed",
         "type": "string",
         "description": "The model's name, as the OpenCode Go plan lists it."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "url": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Plan page",
         "x-kind": "url",
         "x-source": "seed",
         "type": "string",
         "format": "uri",
         "description": "The page where the plan states this model's limits (opencode.ai/go)."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "go_requests_5h": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Requests per 5 hours on the OpenCode Go plan",
         "x-kind": "count",
         "x-source": "ai",
         "type": "integer",
         "minimum": 0,
         "description": "How many requests this model allows in a 5-hour window on the OpenCode Go plan ($10 a month), as the plan page states it."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "go_allowance_usd": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Monthly usage value on the OpenCode Go plan ($)",
         "x-kind": "usd",
         "x-source": "ai",
         "x-unit": "USD",
         "type": "number",
         "minimum": 0,
         "description": "How much model usage, in US dollars, the OpenCode Go plan ($10 a month) gives for this model each month."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "go_plus_requests_5h": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Requests per 5 hours on the OpenCode Go Plus plan",
         "x-kind": "count",
         "x-source": "ai",
         "type": "integer",
         "minimum": 0,
         "description": "How many requests this model allows in a 5-hour window on the OpenCode Go Plus plan ($40 a month), as the plan page states it."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "go_plus_allowance_usd": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Monthly usage value on the OpenCode Go Plus plan ($)",
         "x-kind": "usd",
         "x-source": "ai",
         "x-unit": "USD",
         "type": "number",
         "minimum": 0,
         "description": "How much model usage, in US dollars, the OpenCode Go Plus plan ($40 a month) gives for this model each month."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "review_output_tps": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Answer speed (tokens per second)",
         "x-kind": "number",
         "x-source": "measured",
         "type": "number",
         "description": "Our own measurement: output tokens per second while the model was writing, over 3 timed runs of the same 500-token prompt with no tools, on the EchoLike mini PC. Measured by us, not a vendor figure."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "review_ttft_ms": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Time to first token (milliseconds)",
         "x-kind": "number",
         "x-source": "measured",
         "type": "number",
         "description": "Our own measurement: milliseconds until the model wrote its first token, median of 3 timed runs of the same prompt, no tools, on the EchoLike mini PC."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "review_error_pct": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Failed or empty answers (%)",
         "x-kind": "percent",
         "x-source": "measured",
         "x-unit": "percent",
         "type": "number",
         "minimum": 0,
         "maximum": 100,
         "description": "Our own measurement: share of the 3 timed runs in which the model failed, timed out or gave no answer, in percent."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    },
    "notes": {
     "type": "object",
     "properties": {
      "value": {
       "anyOf": [
        {
         "title": "Notes",
         "x-kind": "text",
         "x-source": "manual",
         "type": "string",
         "description": "Our editorial notes about this entry."
        },
        {
         "type": "null"
        }
       ]
      },
      "conf": {
       "type": "number"
      },
      "src": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     }
    }
   }
  }
 }
}